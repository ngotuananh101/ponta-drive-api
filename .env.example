APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

# Global per-request timeout (seconds) enforced by the gin timeout middleware.
# When it fires the request is aborted with a bare 408 and no log is written,
# so keep it above the duration of any outbound call (e.g. cloud storage
# connection tests) that a request performs.
HTTP_REQUEST_TIMEOUT=60

# Queue driver. "sync" runs each dispatched job inline, inside the HTTP request
# that dispatched it, so a full bucket scan can outlive HTTP_REQUEST_TIMEOUT and
# abort the request with a bare 408. Set QUEUE_CONNECTION=database to store jobs
# in the `jobs` table instead; a worker inside the server process then runs them
# and the request returns immediately. Switching to "database" needs the `jobs`
# and `failed_jobs` tables (run the migrations) and a server restart.
QUEUE_CONNECTION=sync
# Only used by the "database" driver.
QUEUE_NAME=default
QUEUE_CONCURRENT=1

# Frontend public URL for password reset links and external redirects
FRONTEND_URL=http://localhost:5173
# Optional: public logo PNG image URL for transactional emails
APP_LOGO_URL=

JWT_SECRET=

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

# DB_CONNECTION: postgres, mysql, mariadb
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ponta_drive
DB_USERNAME=root
DB_PASSWORD=

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
